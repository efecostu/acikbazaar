# VPS: /docker/acikbazaar-agents/.env (chmod 600)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_APP_URL=https://www.acikbazaar.com
# Araştırma + LLM (OpenRouter)
SERPER_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=google/gemini-2.5-flash-lite
LLM_MODEL_STRONG=google/gemini-2.5-flash
# Opsiyonel: SERPER yoksa çözüm/üretim Claude'a düşer
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# Opsiyonel: ops uyarı e-postası
RESEND_API_KEY=
ADMIN_EMAIL=
# Ayarlar (varsayılanlar)
# TARGET_ACTIVE_MARKETS=45  SCOUT_MAX_ACTIVE=70  SCOUT_FRESH_HOURS=24
# TRACKER_BATCH=6  TRACKER_STALE_HOURS=12  TRADER_BETS_MIN=2  TRADER_BETS_MAX=6
