# ---- Supabase (Project Settings → API) ----
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # sadece sunucu; cron, admin, settle

# ---- Anthropic (market üretimi + otomatik çözüm, web search) ----
ANTHROPIC_API_KEY=
# Bot yorumları için ucuz OpenAI-uyumlu model (opsiyonel; yoksa Anthropic, o da yoksa şablon havuzu)
# OpenRouter: LLM_BASE_URL=https://openrouter.ai/api/v1  LLM_MODEL=
# Ucuz araştırma yolu: Serper (serper.dev, 2.500 ücretsiz arama) + LLM_* → Anthropic'e gerek kalmaz
SERPER_API_KEY=
# Karar/üretim modeli (OpenRouter): varsayılan google/gemini-2.5-flash
LLM_MODEL_STRONG=google/gemini-2.5-flash-lite
# Market üretimi/çözüm modeli (varsayılan en ucuz: Haiku 4.5)
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# ---- Uygulama ----
NEXT_PUBLIC_APP_NAME=AçıkBazaar
NEXT_PUBLIC_APP_URL=https://acikbazaar.com   # prod'da MUTLAKA https://... (bot tetikleyici, OG, e-posta linkleri)
# Gece raporu alıcıları (virgülle ayrılmış); boşsa ADMIN_EMAIL
REPORT_EMAILS=
ADMIN_EMAIL=efecostu01@gmail.com             # /admin'e girebilen hesap
ADMIN_SECRET=                                # x-admin-secret header'ı ile manuel cron/generate/settle

# ---- Vercel Cron (vercel.json) ----
# Vercel bu değeri "Authorization: Bearer <CRON_SECRET>" olarak gönderir.
# TANIMLI DEĞİLSE günlük çözüm ve rapor cron'ları 401 alır → hiçbir market çözülmez.
CRON_SECRET=

# ---- Resend (kazanç e-postaları + günlük rapor) ----
RESEND_API_KEY=
